rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Người dùng bắt buộc phải đăng nhập vào hệ thống
    function dangNhap() {
      return request.auth != null;
    }

    // 1. Hồ sơ nhân sự & Danh mục tổ chức
    match /nhan_su/{id} {
      allow read, write: if true;
    }

    match /chi_nhanh/{id} {
      allow read, write: if dangNhap();
    }

    match /phong_ban/{id} {
      allow read, write: if dangNhap();
    }

    match /vai_tro/{id} {
      allow read, write: if dangNhap();
    }

    match /chuc_vu/{id} {
      allow read, write: if dangNhap();
    }

    // 2. Khách hàng & Người liên hệ
    match /khach_hang/{id} {
      allow read, write: if dangNhap();
    }

    match /nguoi_lien_he/{id} {
      allow read, write: if dangNhap();
    }

    // 3. Hồ sơ dự án & Tiến độ
    match /ho_so_du_an/{id} {
      allow read, write: if dangNhap();
    }

    match /tien_do_du_an/{id} {
      allow read, write: if dangNhap();
    }

    match /tai_lieu_du_an/{id} {
      allow read, write: if dangNhap();
    }

    // 4. Công việc & Báo cáo
    match /cong_viec/{id} {
      allow read, write: if dangNhap();
    }

    match /bao_cao_cong_viec/{id} {
      allow read, write: if dangNhap();
    }

    // 5. Kế hoạch & Sản phẩm dịch vụ
    match /ke_hoach_thang/{id} {
      allow read, write: if dangNhap();
    }

    match /ke_hoach_tuan/{id} {
      allow read, write: if dangNhap();
    }

    match /san_pham_dich_vu/{id} {
      allow read, write: if dangNhap();
    }

    match /nhom_san_pham_dich_vu/{id} {
      allow read, write: if dangNhap();
    }

    // 6. Cấu hình hệ thống & Nhật ký hoạt động
    match /cau_hinh_he_thong/{id} {
      allow read, write: if dangNhap();
    }

    match /nhat_ky_hoat_dong/{id} {
      allow read, write: if dangNhap();
    }
  }
}
